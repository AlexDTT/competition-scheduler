{
  "name": "roundhouse-competition-planner",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": "^20.19.0 || >=22.12.0"},
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "concurrently --kill-others --names api,web \"npm run dev:server\" \"vite preview\"",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {"express": "5.1.0", "react": "19.2.0", "react-dom": "19.2.0"},
  "devDependencies": {"@tailwindcss/vite": "4.3.3", "@vitejs/plugin-react": "5.2.0", "concurrently": "9.2.1", "tailwindcss": "4.3.3", "vite": "^7.3.6"}
}
